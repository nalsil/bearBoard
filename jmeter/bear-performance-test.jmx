<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Bear Application Performance Test">
      <stringProp name="TestPlan.comments">Comprehensive Load &amp; Stress Test for Bear Application Public Endpoints</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="SERVER_HOST" elementType="Argument">
            <stringProp name="Argument.name">SERVER_HOST</stringProp>
            <stringProp name="Argument.value">${__P(server.host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SERVER_PORT" elementType="Argument">
            <stringProp name="Argument.name">SERVER_PORT</stringProp>
            <stringProp name="Argument.value">${__P(server.port,8080)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="COMPANY_CODE" elementType="Argument">
            <stringProp name="Argument.name">COMPANY_CODE</stringProp>
            <stringProp name="Argument.value">${__P(company.code,company-a)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SAMPLE_PRODUCT_ID" elementType="Argument">
            <stringProp name="Argument.name">SAMPLE_PRODUCT_ID</stringProp>
            <stringProp name="Argument.value">${__P(sample.product.id,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SAMPLE_POST_ID" elementType="Argument">
            <stringProp name="Argument.name">SAMPLE_POST_ID</stringProp>
            <stringProp name="Argument.value">${__P(sample.post.id,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SAMPLE_QNA_ID" elementType="Argument">
            <stringProp name="Argument.name">SAMPLE_QNA_ID</stringProp>
            <stringProp name="Argument.value">${__P(sample.qna.id,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SAMPLE_YOUTUBE_ID" elementType="Argument">
            <stringProp name="Argument.name">SAMPLE_YOUTUBE_ID</stringProp>
            <stringProp name="Argument.value">${__P(sample.youtube.id,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BOARD_TYPE" elementType="Argument">
            <stringProp name="Argument.name">BOARD_TYPE</stringProp>
            <stringProp name="Argument.value">${__P(board.type,notice)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PRODUCT_CATEGORY" elementType="Argument">
            <stringProp name="Argument.name">PRODUCT_CATEGORY</stringProp>
            <stringProp name="Argument.value">${__P(product.category,electronics)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FAQ_CATEGORY" elementType="Argument">
            <stringProp name="Argument.name">FAQ_CATEGORY</stringProp>
            <stringProp name="Argument.value">${__P(faq.category,general)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SEARCH_KEYWORD" elementType="Argument">
            <stringProp name="Argument.name">SEARCH_KEYWORD</stringProp>
            <stringProp name="Argument.value">${__P(search.keyword,test)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <intProp name="HTTPSampler.connect_timeout">5000</intProp>
        <intProp name="HTTPSampler.response_timeout">30000</intProp>
        <stringProp name="HTTPSampler.domain">${SERVER_HOST}</stringProp>
        <stringProp name="HTTPSampler.port">${SERVER_PORT}</stringProp>
