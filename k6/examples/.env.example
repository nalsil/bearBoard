# k6 Load Test 환경 변수 예시
# 사용법: 이 파일을 .env로 복사하고 실제 값으로 수정

# 기본 URL (필수)
BASE_URL=http://localhost:8080

# 테스트할 기업 코드 (필수 - 실제 DB에 존재하는 코드)
COMPANY_CODE=demo-company

# 샘플 데이터 ID (실제 DB에 존재하는 ID로 변경 필요)
SAMPLE_PRODUCT_ID=1
SAMPLE_POST_ID=1
SAMPLE_FAQ_ID=1
SAMPLE_QNA_ID=1
SAMPLE_YOUTUBE_ID=1
SAMPLE_BOARD_TYPE=notice

# 테스트 타입 (선택)
TEST_TYPE=load

# 환경 구분 (선택)
ENVIRONMENT=local

# 사용 예시:
# 1. 로컬 환경 테스트
#    k6 run --env BASE_URL=http://localhost:8080 --env COMPANY_CODE=demo scenarios/smoke-test.js
#
# 2. 스테이징 환경 테스트
#    k6 run --env BASE_URL=https://staging.example.com --env COMPANY_CODE=real-company scenarios/load-test.js
#
# 3. 프로덕션 환경 테스트 (주의!)
#    k6 run --env BASE_URL=https://www.example.com --env COMPANY_CODE=production scenarios/smoke-test.js
